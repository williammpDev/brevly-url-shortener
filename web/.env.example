# Copie para web/.env antes de rodar o frontend: cp .env.example .env
# Tudo com prefixo VITE_ vai para o bundle e fica publico: nunca coloque
# segredo aqui. As credenciais do Postgres e do R2 vivem em server/.env.

# Onde o frontend esta publicado. E com esta base que a interface monta a URL
# curta a partir do slug devolvido pela API.
VITE_FRONTEND_URL="http://localhost:5173"

# Base da API consumida pelo frontend.
VITE_BACKEND_URL="http://localhost:3333"
