# Copie para .env antes de subir o ambiente local: cp .env.example .env
# O docker-compose.yml lê este arquivo automaticamente, e o server o carrega no
# script de dev. Os valores abaixo são os mesmos que o compose assume por
# padrão, então o ambiente local funciona sem edição — troque a senha se for
# expor a porta para fora da máquina.

# Postgres do ambiente local (docker-compose.yml)
POSTGRES_USER=brevly
POSTGRES_PASSWORD=brevly
POSTGRES_DB=brevly
POSTGRES_PORT=5432

# Server. Validadas na inicialização por server/src/lib/env.ts: se faltar uma
# obrigatória ou o formato estiver errado, o processo para com a lista do que
# está errado. DATABASE_URL precisa refletir as variáveis do Postgres acima.
PORT=3333
NODE_ENV=development
DATABASE_URL=postgresql://brevly:brevly@localhost:5432/brevly

# Cloudflare R2, usado pelo relatório em CSV. Ainda não validado nem lido pelo
# server: entra no schema de env quando o cliente for criado (Issue #17).
# Segredo nenhum daqui pode ganhar prefixo VITE_ — tudo que tem esse prefixo vai
# para o bundle do frontend e fica público.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET=brevly-reports
CLOUDFLARE_PUBLIC_URL=https://pub-exemplo.r2.dev
