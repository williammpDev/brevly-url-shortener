# Copie para .env antes de subir o ambiente local: cp .env.example .env
# O docker-compose.yml lê este arquivo automaticamente. Os valores abaixo são
# os mesmos que o compose assume por padrão, então o ambiente local funciona
# sem edição — troque a senha se for expor a porta para fora da máquina.

# Postgres do ambiente local (docker-compose.yml)
POSTGRES_USER=brevly
POSTGRES_PASSWORD=brevly
POSTGRES_DB=brevly
POSTGRES_PORT=5432

# String de conexão usada pelo server. Precisa refletir as variáveis acima.
# A validação dessas variáveis na inicialização do server entra na Issue #11.
DATABASE_URL=postgresql://brevly:brevly@localhost:5432/brevly
