# Copie para .env antes de subir o ambiente local: cp .env.example .env
# Este arquivo serve apenas ao docker-compose.yml, que sobe o Postgres.
# A configuracao das aplicacoes fica em server/.env.example e web/.env.example.
# Os valores abaixo sao os mesmos que o compose assume por padrao, entao o
# ambiente local funciona sem edicao — troque a senha se for expor a porta.

POSTGRES_USER=brevly
POSTGRES_PASSWORD=brevly
POSTGRES_DB=brevly
POSTGRES_PORT=5432
