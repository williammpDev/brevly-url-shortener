# Copie para server/.env antes de rodar o server: cp .env.example .env
# Os scripts dev e db:* leem este arquivo. Nada aqui vai para o frontend.

PORT=3333
DATABASE_URL="postgresql://brevly:brevly@localhost:5432/brevly"

# Cloudflare R2, usado pelo relatorio em CSV (Issues #17 e #18).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET=""
CLOUDFLARE_PUBLIC_URL=""
