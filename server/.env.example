# Copie para server/.env antes de rodar o server: cp .env.example .env
# Os scripts dev e db:* leem este arquivo. Nada aqui vai para o frontend.

PORT=3333
DATABASE_URL="postgresql://brevly:brevly@localhost:5432/brevly"

# Cloudflare R2, usado pelo relatorio em CSV. Validadas na inicializacao.
# ACCOUNT_ID e so o ID da conta: 32 caracteres hexadecimais, sem https:// e
# sem .r2.cloudflarestorage.com. O painel mostra o endpoint completo bem ao
# lado, e colar o endpoint inteiro aqui faz o cliente montar uma URL dupla.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY_ID=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKET=""
CLOUDFLARE_PUBLIC_URL=""

# Base das URLs curtas, usada na coluna "URL encurtada" do relatorio em CSV.
# Em desenvolvimento e o endereco do Vite; em producao, o dominio do frontend.
SHORT_LINK_BASE_URL="http://localhost:5173"
